{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeDevRds",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBEngineVersions",
        "rds:DescribeDBInstances",
        "rds:DescribeDBParameterGroups",
        "rds:DescribeDBParameters",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeOrderableDBInstanceOptions",
        "rds:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "CreateOnlyMicroPostgres",
      "Effect": "Allow",
      "Action": "rds:CreateDBInstance",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:486726633485:db:orbexa-dev",
        "arn:aws:rds:ap-southeast-2:486726633485:pg:orbexa-dev-pg16",
        "arn:aws:rds:ap-southeast-2:486726633485:subgrp:orbexa-dev",
        "arn:aws:rds:ap-southeast-2:486726633485:og:*"
      ],
      "Condition": {
        "StringEquals": {
          "rds:DatabaseClass": "db.t4g.micro",
          "rds:DatabaseEngine": "postgres"
        }
      }
    },
    {
      "Sid": "ManageDevRds",
      "Effect": "Allow",
      "Action": [
        "rds:AddTagsToResource",
        "rds:CreateDBParameterGroup",
        "rds:CreateDBSubnetGroup",
        "rds:DeleteDBInstance",
        "rds:DeleteDBParameterGroup",
        "rds:DeleteDBSubnetGroup",
        "rds:ModifyDBInstance",
        "rds:ModifyDBParameterGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:RemoveTagsFromResource",
        "rds:StartDBInstance",
        "rds:StopDBInstance"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-2:486726633485:db:orbexa-dev",
        "arn:aws:rds:ap-southeast-2:486726633485:pg:orbexa-dev-pg16",
        "arn:aws:rds:ap-southeast-2:486726633485:subgrp:orbexa-dev"
      ]
    },
    {
      "Sid": "DevAndStateBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::orbexa-dev-tfstate-486726633485",
        "arn:aws:s3:::orbexa-dev-documents-486726633485"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::orbexa-dev-tfstate-486726633485/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "StateLockTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteItem",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:GetItem",
        "dynamodb:ListTagsOfResource",
        "dynamodb:PutItem",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:486726633485:table/orbexa-dev-tfstate-lock"
    },
    {
      "Sid": "DevQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": "arn:aws:sqs:ap-southeast-2:486726633485:orbexa-dev-*"
    },
    {
      "Sid": "ListQueues",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DevSecretShells",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "secretsmanager:UpdateSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-2:486726633485:secret:orbexa/dev/*",
        "arn:aws:secretsmanager:ap-southeast-2:486726633485:secret:rds!*"
      ]
    },
    {
      "Sid": "RdsManagedPasswordRotation",
      "Effect": "Allow",
      "Action": "secretsmanager:RotateSecret",
      "Resource": "arn:aws:secretsmanager:ap-southeast-2:486726633485:secret:rds!*"
    },
    {
      "Sid": "DenyLargerThanMicro",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "rds:DatabaseClass": "db.t4g.micro"
        }
      }
    },
    {
      "Sid": "DenyReadReplicas",
      "Effect": "Deny",
      "Action": "rds:CreateDBInstanceReadReplica",
      "Resource": "*"
    },
    {
      "Sid": "DenySecretReadsAndWrites",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCustomerKmsKeys",
      "Effect": "Deny",
      "Action": [
        "kms:CreateKey",
        "kms:DisableKey",
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RdsDefaultKeyViaRds",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:ListGrants",
        "kms:RevokeGrant"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "rds.ap-southeast-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ListKmsAliases",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
