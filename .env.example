# Local only. Do not put real secrets in this file.
# The connected Stripe account is a live ThirdRoc account and must not be used here.

DATABASE_URL=postgres://orbexa:orbexa_local_only@127.0.0.1:54329/orbexa
TEMPORAL_ADDRESS=127.0.0.1:7233
PORT=43124

# Optional demo gate for the Next.js app. Leave empty locally. When this is
# user:password, every route except GET /health and /api/stripe/webhook
# returns 401 until the client sends HTTP Basic Auth.
DEMO_BASIC_AUTH=

# Leave empty. The default payment provider is the local fake adapter.
# Stripe runs only when PAYMENT_PROVIDER=stripe and STRIPE_TEST_SECRET_KEY
# starts with sk_test_. A value containing sk_live_ refuses process start.
# Never paste a live secret key. The live ThirdRoc account must not be used.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# The default model provider is the fixture gateway. Set LLM_PROVIDER to
# anthropic or openai only together with that provider's key. Tests leave both empty.
LLM_PROVIDER=fixture
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
